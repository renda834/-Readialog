READWREN_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INTERVIEW_MODEL=deepseek-flash
DEEPSEEK_PROFILE_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_INTERVIEW_MAX_TOKENS=800
DEEPSEEK_PROFILE_MAX_TOKENS=4000

# Optional Kimi settings when READWREN_PROVIDER=moonshot.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_INTERVIEW_MODEL=kimi-k2-thinking-turbo
MOONSHOT_PROFILE_MODEL=kimi-k2-thinking
MOONSHOT_INTERVIEW_MAX_TOKENS=800
MOONSHOT_PROFILE_MAX_TOKENS=4000
# Leave REDIS_HOST blank to use memory for the current process.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
DEBUG_MODE=false
